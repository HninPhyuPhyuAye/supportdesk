{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "AllowSingaporeEcsTasksToAssumeRole",
			"Effect": "Allow",
			"Principal": {
				"Service": "ecs-tasks.amazonaws.com"
			},
			"Action": "sts:AssumeRole",
			"Condition": {
				"ArnLike": {
					"aws:SourceArn": "arn:aws:ecs:ap-southeast-1:*:*"
				}
			}
		}
	]
}
