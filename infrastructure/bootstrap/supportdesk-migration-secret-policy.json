{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "TemporarilyReadRdsManagedMasterCredential",
			"Effect": "Allow",
			"Action": "secretsmanager:GetSecretValue",
			"Resource": "arn:aws:secretsmanager:ap-southeast-1:*:secret:rds!db-*",
			"Condition": {
				"StringEquals": {
					"aws:RequestedRegion": "ap-southeast-1"
				}
			}
		}
	]
}
